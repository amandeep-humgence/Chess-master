{
  "name": "chess-master",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:server\"",
    "dev:next": "next dev",
    "dev:server": "cd server && npm run dev",
    "build": "next build",
    "build:server": "cd server && npm run build",
    "start": "concurrently \"next start\" \"cd server && npm start\"",
    "lint": "eslint",
    "db:generate": "cd server && npx prisma generate",
    "db:migrate": "cd server && npx prisma migrate dev",
    "db:seed": "cd server && npx prisma db seed",
    "db:studio": "cd server && npx prisma studio",
    "db:reset": "cd server && npx prisma migrate reset"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "axios": "^1.7.9",
    "react-hook-form": "^7.54.2",
    "@hookform/resolvers": "^3.9.0",
    "zod": "^3.24.1",
    "@tanstack/react-query": "^5.64.1",
    "zustand": "^5.0.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "concurrently": "^9.1.2"
  }
}
